+// ---- pcfsite (15-oct-2026): lectura por rangos HTTP de los ficheros grandes, sin descargarlos enteros -------------------
+// Trozos de 1 MiB pedidos con Range (Asyncify espera el fetch) y caché LRU en memoria de hasta 96 trozos. Así un juego
+// de 500 MB arranca al instante y la pestaña no necesita cientos de MB.
+// Lectura SÍNCRONA (XMLHttpRequest sin async): no suspende el wasm con Asyncify, así el callback de audio de SDL no reentra
+// (con fetch+await en mitad del juego se corrompía la pila: «memory access out of bounds»). La página puede redirigir la
+// URL (globalThis.svmRangeUrl) a un Service Worker que sirve los trozos desde la copia local (Cache Storage).
+EM_JS(bool, _httpFsFetchRange, (const char *url, double start, int len, byte *dst), {
+	url = UTF8ToString(url);
+	try {
+		// la página puede dar una URL alternativa: o bien una URL normal (se pide con Range) o bien {url} que ya ES el trozo
+		// (p. ej. blob: de un File.slice() del almacén local → sin depender de que blob: admita Range)
+		var alt = (typeof globalThis.svmRangeUrl === "function") ? globalThis.svmRangeUrl(url, start, len) : null;
+		var sliced = alt && typeof alt === "object";
+		if (alt) url = sliced ? alt.url : alt;
+		const x = new XMLHttpRequest();
+		x.open("GET", url, false);
+		if (!sliced) x.setRequestHeader("Range", "bytes=" + start + "-" + (start + len - 1));
+		x.overrideMimeType("text/plain; charset=x-user-defined");
+		x.send(null);
+		if (sliced && typeof globalThis.svmRangeDone === "function") globalThis.svmRangeDone(alt);
+		if (x.status !== 206 && x.status !== 200) { console.error("HTTPRangeStream: " + url + " " + x.status); return false; }
+		let t = x.responseText;
+		if (!sliced && x.status === 200 && t.length > len) { console.error("HTTPRangeStream: el servidor no admite Range (" + url + ")"); return false; }
+		if (t.length < len) { console.error("HTTPRangeStream: respuesta corta " + url + " " + t.length + " < " + len); return false; }
+		for (let i = 0; i < len; i++) HEAPU8[dst + i] = t.charCodeAt(i) & 255;
+		return true;
+	} catch (e) { console.error(e); return false; }
+});
+
+class HTTPRangeStream : public Common::SeekableReadStream {
+	enum { kChunk = 1 << 20, kMaxChunks = 96 };
+	Common::String _url;
+	int64 _size, _pos;
+	bool _eos, _err;
+	Common::Array<byte *> _chunks;     // por índice de trozo; nullptr = no cargado
+	Common::Array<uint32> _loaded;     // orden de carga (se desaloja el más antiguo)
+
+	byte *chunk(uint32 idx) {
+		if (_chunks[idx])
+			return _chunks[idx];
+		int64 start = (int64)idx * kChunk;
+		int len = (int)MIN<int64>(kChunk, _size - start);
+		byte *buf = new byte[kChunk];
+		if (!_httpFsFetchRange(_url.c_str(), (double)start, len, buf)) {
+			delete[] buf;
+			_err = true;
+			return nullptr;
+		}
+		if (_loaded.size() >= kMaxChunks) {
+			uint32 old = _loaded[0];
+			_loaded.remove_at(0);
+			delete[] _chunks[old];
+			_chunks[old] = nullptr;
+		}
+		_chunks[idx] = buf;
+		_loaded.push_back(idx);
+		return buf;
+	}
+
+public:
+	HTTPRangeStream(const Common::String &url, int64 size) : _url(url), _size(size), _pos(0), _eos(false), _err(false) {
+		uint n = (uint)((size + kChunk - 1) / kChunk);
+		for (uint i = 0; i < n; i++)
+			_chunks.push_back(nullptr);
+	}
+	~HTTPRangeStream() override {
+		for (uint i = 0; i < _chunks.size(); i++)
+			delete[] _chunks[i];
+	}
+	bool eos() const override { return _eos; }
+	bool err() const override { return _err; }
+	void clearErr() override { _err = false; _eos = false; }
+	int64 pos() const override { return _pos; }
+	int64 size() const override { return _size; }
+	bool seek(int64 offset, int whence = SEEK_SET) override {
+		int64 np = _pos;
+		if (whence == SEEK_SET) np = offset; else if (whence == SEEK_CUR) np += offset; else if (whence == SEEK_END) np = _size + offset; else return false;
+		if (np < 0 || np > _size) return false;
+		_pos = np; _eos = false;
+		return true;
+	}
+	uint32 read(void *dataPtr, uint32 dataSize) override {
+		byte *dst = (byte *)dataPtr;
+		uint32 done = 0;
+		while (done < dataSize && _pos < _size) {
+			uint32 idx = (uint32)(_pos / kChunk), off = (uint32)(_pos % kChunk);
+			uint32 avail = (uint32)MIN<int64>((int64)kChunk - off, _size - _pos);
+			uint32 n = MIN(avail, dataSize - done);
+			byte *c = chunk(idx);
+			if (!c) break;
+			memcpy(dst + done, c + off, n);
+			done += n; _pos += n;
+		}
+		if (done < dataSize) _eos = true;
+		return done;
+	}
+};
